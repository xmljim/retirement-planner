<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs exclusions for retirement-planner. Per ADR-009: keep this
  list short and intentional. Each entry should have a comment.
-->
<FindBugsFilter
        xmlns="https://github.com/spotbugs/filter/3.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/master/spotbugs/etc/findbugsfilter.xsd">

    <!-- Spring Boot main class: SpotBugs flags the @SpringBootApplication
         convention; these are false positives. -->
    <Match>
        <Class name="~.*\.RetirementPlannerApplication"/>
        <Bug pattern="UWF_UNWRITTEN_FIELD,UPM_UNCALLED_PRIVATE_METHOD"/>
    </Match>

    <!-- Generated sources -->
    <Match>
        <Source name="~.*[/\\]generated[/\\].*"/>
    </Match>

    <!-- Records: SpotBugs sometimes flags getter accessors as
         EI_EXPOSE_REP. Records have value semantics; this is intended. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
        <Class name="~.*\.(model|dto|api\.dto|shared)\..*"/>
    </Match>

    <!-- findsecbugs SPRING_ENDPOINT flags every @RequestMapping method as
         a "Spring endpoint to audit." This codebase IS a REST API; every
         such method is intentionally exposed. Auth (S-1.8) installs a
         stub principal in stub mode; passkey lands in EPIC-8. The
         advisory is duplicated for *Operations interfaces and their
         *Controller impls, doubling the noise. -->
    <Match>
        <Bug pattern="SPRING_ENDPOINT"/>
        <Class name="~io\.github\.xmljim\.retirement\.retirementplanner\.api\..*"/>
    </Match>

    <!-- OriginCheckFilter intentionally reads Origin/Referer headers —
         that's its job. findsecbugs flags any header read as advisory;
         the threat model and limits are documented in the filter's
         Javadoc (defense in depth, not a CSRF substitute). -->
    <Match>
        <Class name="io.github.xmljim.retirement.retirementplanner.shared.internal.OriginCheckFilter"/>
        <Bug pattern="SERVLET_HEADER,SERVLET_HEADER_REFERER"/>
    </Match>

    <!-- HttpSecurity.build() declares Exception in the Spring Security
         API; bubbling it from a SecurityFilterChain @Bean is the
         canonical pattern. -->
    <Match>
        <Class name="io.github.xmljim.retirement.retirementplanner.shared.internal.SecurityConfig"/>
        <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION"/>
    </Match>

    <!-- StubAuthenticationToken is created per-request and never stored
         in a session (stateless SessionCreationPolicy in SecurityConfig).
         Spring Security's AbstractAuthenticationToken implements
         Serializable; the transient principal is intentional. -->
    <Match>
        <Class name="~io\.github\.xmljim\.retirement\.retirementplanner\.shared\.internal\.StubAuthenticationFilter\$StubAuthenticationToken"/>
        <Bug pattern="SE_TRANSIENT_FIELD_NOT_RESTORED"/>
    </Match>
</FindBugsFilter>
